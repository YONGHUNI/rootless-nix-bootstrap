#!/usr/bin/env bash
set -Eeuo pipefail

STATE_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/rootless-nix-bootstrap/state.env"
[[ -r "$STATE_FILE" ]] || {
    echo "rootless-nix-bootstrap: state file not found: $STATE_FILE" >&2
    exit 127
}
# shellcheck disable=SC1090
source "$STATE_FILE"

# A node-local Nix cache avoids sharing Nix's SQLite fetch/eval caches across
# different Slurm compute nodes. NIX_CACHE_HOME is Nix-specific, unlike
# XDG_CACHE_HOME, so this does not relocate caches for Pixi, Python, Hugging
# Face, or other tools launched from a Nix shell.
#
# Explicit user intent always wins. RNB_NIX_CACHE_HOME is an optional
# rootless-nix-bootstrap-specific override. Otherwise, Slurm jobs choose a
# node-local location automatically while non-Slurm use keeps Nix's default
# cache location.
rnb_configure_nix_cache() {
    local cache_home='' old_umask

    [[ -n "${NIX_CACHE_HOME:-}" ]] && return 0

    if [[ -n "${RNB_NIX_CACHE_HOME:-}" ]]; then
        cache_home=$RNB_NIX_CACHE_HOME
    elif [[ -n "${SLURM_JOB_ID:-}" ]]; then
        case "$RNB_STORE_ROOT" in
            /tmp/*|/var/tmp/*)
                # When the physical store already lives on node-local tmp
                # storage (for example Sapelo2 /lscratch -> /tmp/lscratch),
                # keep the cache beside it so repeated jobs on that node can
                # reuse the cache without crossing the shared home filesystem.
                cache_home="$(dirname "$RNB_STORE_ROOT")/.cache/nix"
                ;;
            *)
                if [[ -n "${SLURM_TMPDIR:-}" && -d "$SLURM_TMPDIR" && -w "$SLURM_TMPDIR" ]]; then
                    cache_home="$SLURM_TMPDIR/rootless-nix-bootstrap/nix"
                else
                    cache_home="/tmp/rootless-nix-bootstrap-${UID}/nix"
                fi
                ;;
        esac
    else
        return 0
    fi

    old_umask=$(umask)
    umask 077
    if ! mkdir -p "$cache_home"; then
        umask "$old_umask"
        echo "rootless-nix-bootstrap: cannot create Nix cache directory: $cache_home" >&2
        exit 1
    fi
    umask "$old_umask"

    if [[ ! -O "$cache_home" ]]; then
        echo "rootless-nix-bootstrap: refusing Nix cache directory not owned by the current user: $cache_home" >&2
        exit 1
    fi

    export NIX_CACHE_HOME="$cache_home"
}

if [[ "$RNB_BACKEND" == user-chroot && ! -d "$RNB_STORE_ROOT" ]]; then
    cat >&2 <<EOF_STORE
rootless-nix-bootstrap: the configured rootless Nix store is not initialized on this node:
  $RNB_STORE_ROOT
Run bootstrap.sh on the target compute node/allocation before invoking nix.
EOF_STORE
    exit 127
fi

rnb_configure_nix_cache

# Reuse the host CA bundle when Nix's own default trust path does not match the
# host distribution. Keep any explicit user setting untouched.
if [[ -z "${NIX_SSL_CERT_FILE:-}" ]]; then
    for cert in \
        /etc/ssl/certs/ca-certificates.crt \
        /etc/pki/tls/certs/ca-bundle.crt \
        /etc/ssl/certs/ca-bundle.crt \
        /etc/ssl/cert.pem; do
        if [[ -r "$cert" ]]; then
            export NIX_SSL_CERT_FILE="$cert"
            break
        fi
    done
fi

case "$RNB_BACKEND" in
    user-chroot)
        root_method=${RNB_USER_CHROOT_ROOT_METHOD:-pivot}
        case "$root_method" in
            pivot) backend_root_args=() ;;
            chroot) backend_root_args=(--root-method chroot) ;;
            *)
                echo "rootless-nix-bootstrap: unknown user-chroot root method: $root_method" >&2
                exit 2
                ;;
        esac

        # For pivot, backend_root_args is empty, so the upstream invocation is
        # byte-for-byte equivalent at the argument level to the historical path.
        # The single-quoted script is intentionally expanded by the inner Bash.
        # shellcheck disable=SC2016
        exec "$RNB_BACKEND_BIN" "${backend_root_args[@]}" "$RNB_STORE_ROOT" bash -c '
            real_nix="$HOME/.nix-profile/bin/nix"
            if [ ! -x "$real_nix" ]; then
                echo "rootless-nix-bootstrap: Nix profile is missing inside the rootless store" >&2
                exit 127
            fi

            # nix-user-chroot bind-mounts the managed NVIDIA driver bridge here.
            # Keep the bridge scoped to the wrapper and its children rather than
            # modifying the login shell globally.
            if [ -d /run/opengl-driver/lib ]; then
                case ":${LD_LIBRARY_PATH:-}:" in
                    *:/run/opengl-driver/lib:*) ;;
                    *) export LD_LIBRARY_PATH="/run/opengl-driver/lib${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}" ;;
                esac
            fi

            exec "$real_nix" "$@"
        ' rootless-nix "$@"
        ;;
    portable)
        export NP_LOCATION="$RNB_STORE_ROOT"
        # nix-portable otherwise bootstraps its own Git on first use. Reuse a
        # host Git when available, which avoids an unnecessary Nix build and
        # makes the PRoot fallback more reliable on restricted CI hosts.
        if [[ -z "${NP_GIT:-}" ]] && command -v git >/dev/null 2>&1; then
            NP_GIT=$(command -v git)
            export NP_GIT
        fi
        exec "$RNB_BACKEND_BIN" nix "$@"
        ;;
    *)
        echo "rootless-nix-bootstrap: unknown backend: $RNB_BACKEND" >&2
        exit 2
        ;;
esac
